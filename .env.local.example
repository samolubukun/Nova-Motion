# ============================================
# CONTENT NOVA VIDEO ENGINE CONFIGURATION
# ============================================

# ============================================
# AI API KEYS (Required)
# ============================================

# OpenAI API Key (https://platform.openai.com/)
# Required for AIStoryboardVideo mode (gpt-4o-mini scripts + gpt-image-2 illustrations),
# and as the fallback LLM for Luma screenplay planning.
OPENAI_API_KEY=sk-proj-xxxxx

# ElevenLabs API Key (https://elevenlabs.io/)
# Primary TTS provider with native word-level timestamps (captions). Used by
# AIStoryboardVideo, StockVideo, StockImage, TextToVideo, MicroDrama, UGC, and Luma modes.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Deepgram API Key (https://console.deepgram.com/)
# Fallback TTS provider (Aura voices) + Nova-2 STT for word timestamps when ElevenLabs is absent.
DEEPGRAM_API_KEY=your-deepgram-api-key

# Pexels API Key (https://www.pexels.com/api/)
# Required for StockVideo mode (stock video loops).
PEXELS_API_KEY=your-pexels-api-key

# Pixabay API Key (https://pixabay.com/api/docs/)
# Required for StockImage mode (stock images).
PIXABAY_API_KEY=your-pixabay-api-key

# WaveSpeed API Key (https://wavespeed.ai)
# Required for TextToVideo, MicroDrama, and UGC modes (Seedance video, Seedream images, Lyria music,
# lipsync-2). Also used as the LLM for Luma screenplay planning (fallback to OPENAI_API_KEY).
WAVESPEED_API_KEY=your-wavespeed-api-key

# Luma Agents API Key (https://agents.lumalabs.ai/)
# Required for Luma mode (Ray 3.2: Text-to-Video, Image-to-Video, Loop, Extend, Video Edit, Video Reframe).
LUMA_AGENTS_API_KEY=your-luma-agents-api-key

# ============================================
# RENDER SERVER SETTINGS
# ============================================

# URL the Next.js gateway submits render jobs to.
# Local development: http://localhost:3001
# Production: https://your-render-server.com
RENDER_SERVER_URL=http://localhost:3001

# Public URL of the render server. Used for final video serving links and as the
# webhook base for UGC/lip-sync TTS audio (WaveSpeed fetches the audio from here).
# Production: https://your-tunnel-url.trycloudflare.com
RENDER_SERVER_BASE_URL=http://localhost:3001

# Shared secret between the Next.js gateway and the render server (must match on both).
RENDER_SERVER_SECRET=your-secret-key-here

# Port for the render server (default: 3001)
RENDER_SERVER_PORT=3001

# Chromium render concurrency (default: 2). Raise on a beefy GPU/CPU box.
RENDER_CONCURRENCY=2

# Public App URL (Next.js gateway)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# WAVESPEED MODEL DEFAULTS (Optional overrides)
# ============================================

# Text-to-video model for TextToVideo B-roll (default: cheapest Seedance, $0.06/run)
WAVESPEED_VIDEO_MODEL=bytedance/seedance-v1-pro-fast/text-to-video

# Clip resolution (480p cheapest; 720p for better quality)
WAVESPEED_VIDEO_RESOLUTION=480p

# Clip duration in seconds (3-10; segments are sized to match). 5 = ~9 clips per 45s video
WAVESPEED_VIDEO_DURATION=5

# LLM used for MicroDrama story/characters/script/storyboard and UGC multi-scene planning
WAVESPEED_LLM_MODEL=deepseek/deepseek-v4-flash

# Text-to-image model for UGC reference images and scenes
WAVESPEED_IMAGE_MODEL=bytedance/seedream-v4.5

# MicroDrama character portraits
WAVESPEED_PORTRAIT_MODEL=bytedance/seedream-v4.5

# MicroDrama scene first-frames
WAVESPEED_FRAME_MODEL=bytedance/seedream-v4.5

# Image-to-video model for animating each shot's first frame into a clip
WAVESPEED_I2V_MODEL=bytedance/seedance-2.0/image-to-video

# Default UGC model when none is specified: veo-3-1 | seedance-2 | grok-video | happy-horse
UGC_DEFAULT_MODEL=seedance-2

# ============================================
# LUMA LLM DEFAULTS (Optional overrides)
# ============================================

# LLM endpoint used for Luma multi-scene screenplay planning
LUMA_LLM_URL=https://llm.wavespeed.ai/v1/chat/completions

# LLM model used for Luma multi-scene screenplay planning
LUMA_LLM_MODEL=deepseek/deepseek-v4-flash

# ============================================
# VOX LLM DEFAULTS (Optional overrides)
# ============================================

# LLM endpoint used for Vox beat-map planning (defaults to the WaveSpeed LLM)
VOX_LLM_URL=https://llm.wavespeed.ai/v1/chat/completions

# LLM model used for Vox beat-map planning
VOX_LLM_MODEL=deepseek/deepseek-v4-flash

# ============================================
# ZACK D 3D SHORT DEFAULTS (Optional overrides)
# ============================================

# LLM endpoint/model used for ZackD curiosity-loop beat-map planning
# (defaults to the WaveSpeed LLM)
ZACK_D_LLM_URL=https://llm.wavespeed.ai/v1/chat/completions
ZACK_D_LLM_MODEL=deepseek/deepseek-v4-flash

# Image-to-video model used to animate ZackD keyframes
# (defaults to Seedance 2.0; switch to Veo for Google-quality motion)
ZACK_D_I2V_MODEL=bytedance/seedance-2.0/image-to-video

# ============================================
# DIGITALOCEAN SPACES / S3 STORAGE (OPTIONAL)
# ============================================
# If none of these are set, output videos are saved to local disk.

# DO Spaces endpoint (e.g. https://sfo3.digitaloceanspaces.com)
SPACES_ENDPOINT=https://your-region.digitaloceanspaces.com

# Access key ID
SPACES_KEY=your-do-spaces-access-key

# Secret access key
SPACES_SECRET=your-do-spaces-secret-key

# Space Bucket Name
SPACES_BUCKET_NAME=your-bucket-name

# Public CDN/Endpoint URL
SPACES_PUBLIC_URL=https://your-bucket-name.your-region.digitaloceanspaces.com

# ============================================
# CLOUDFLARE R2 STORAGE (OPTIONAL)
# ============================================
# Alternative to DO Spaces. If neither storage provider is configured, videos are stored locally.

# R2 Account ID (used to build the endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=your-r2-account-id

# R2 Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 Bucket Name
R2_BUCKET_NAME=your-bucket-name

# Public URL for R2-served videos (e.g. https://<ACCOUNT_ID>.r2.dev/<BUCKET>)
R2_PUBLIC_URL=https://your-account-id.r2.dev/your-bucket-name

# Delete the local mp4 after uploading to R2 (true/false)
R2_DELETE_LOCAL_AFTER_UPLOAD=false
